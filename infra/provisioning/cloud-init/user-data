#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: meridian-lab
    username: analyst
    password: "$6$meridianlab$IGt2tjjzBbKWUQuQ8zdaH.ypWN6L7AAmMmbjwkF/m9UIyoSlFPkltE.82cZC/ADNCIYhUWNUq8AkhhKJQtn7O0" # analyst:analyst
    realname: "PARALLAX Investigator"
  locale: en_US.UTF-8
  keyboard:
    layout: us
  ssh:
    install-server: true
    allow-pw: true
  network:
    network:
      version: 2
      ethernets:
        all-en:
          match:
            name: "en*|eth*"
          dhcp4: true
  packages:
    - python3
    - python3-pip
    - python3-venv
    - build-essential
    - auditd
    - iproute2
    - curl
    - net-tools
    - acl
    - git
  late-commands:
    # Ensure analyst is member of systemd-journal
    - curtin in-target --target=/target -- usermod -a -G systemd-journal analyst
    # Execute non-interactive safe preparation
    - curtin in-target --target=/target -- bash -c "if [ -f /opt/parallax/infra/provisioning/provision.sh ]; then /opt/parallax/infra/provisioning/provision.sh --prepare; fi"
  user-data:
    disable_root: false
